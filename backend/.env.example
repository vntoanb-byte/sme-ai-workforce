# ─── Mô hình ───
# Phát triển: dùng dịch vụ trung gian
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-vl-8b-instruct
LLM_API_KEY=sk-or-v1-DOI-THANH-KHOA-CUA-BAN
# Vận hành: đổi hai dòng trên thành
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=Qwen3-VL-8B
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3

# ─── Cơ sở dữ liệu và kho tệp ───
DATABASE_URL=sqlite:///./data/app.db
STORAGE_PATH=./data/artifacts
BACKUP_PATH=./data/backup

# ─── Xử lý nền ───
WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=900
JOB_POLL_INTERVAL_SEC=2
WATCH_PATH=./data/scan
# Công cụ trong quy trình chỉ đọc tệp dưới WATCH_PATH và các thư mục này (JSON)
FS_ALLOWED_ROOTS=[]
TIMEZONE=Asia/Ho_Chi_Minh

# ─── Xử lý ảnh ───
IMAGE_MAX_LONG_EDGE=1280
IMAGE_MAX_PIXELS=1638400
PDF_RENDER_DPI=150

# ─── Bảo mật ───
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Để nguyên giá trị mẫu = coi như CHƯA đặt (dùng khoá tạm, phiên mất khi khởi động lại)
JWT_SECRET=SINH-NGAU-NHIEN-32-BYTE
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CREDENTIAL_ENC_KEY=SINH-NGAU-NHIEN-32-BYTE
MAX_UPLOAD_MB=20
# Đặt true khi chạy sau HTTPS (cookie phiên chỉ gửi qua HTTPS)
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# ─── Giao diện và báo cáo ───
STATIC_DIR=./static
# Rỗng = tự dò phông DejaVuSans; đặt đường dẫn TTF có dấu tiếng Việt nếu cần
REPORT_FONT_PATH=

# ─── Tài khoản quản trị đầu tiên ───
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=doi-mat-khau-nay
